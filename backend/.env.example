# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/inkcraft

# JWT Secret (Generate a strong secret key for production)
JWT_SECRET=your_super_secret_jwt_key_here

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# Frontend base URL used in password-reset emails
FRONTEND_URL=http://localhost:3000

# Groq API key for AI tattoo design generation
GROQ_API_KEY=your_groq_api_key_here

# AI image generation settings (real tattoo artwork output)
# Supported provider: pollinations
AI_IMAGE_PROVIDER=pollinations
AI_IMAGE_MODEL=flux
AI_IMAGE_WIDTH=1024
AI_IMAGE_HEIGHT=1024

# SMTP configuration for forgot-password emails
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_mailtrap_username
EMAIL_PASS=your_mailtrap_password
EMAIL_FROM="InkCraft <no-reply@inkcraft.local>"